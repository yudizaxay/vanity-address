{
  "name": "vanity-address",
  "version": "0.8.0",
  "description": "Fast, offline, multi-chain vanity address generator — CLI + WASM SDK, no telemetry",
  "license": "MIT",
  "author": "yudizaxay",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "type": "commonjs",
  "sideEffects": false,
  "homepage": "https://vanity-address.online/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yudizaxay/vanity-address.git"
  },
  "bugs": {
    "url": "https://github.com/yudizaxay/vanity-address/issues"
  },
  "keywords": [
    "vanity-address",
    "vanity",
    "vanity-wallet",
    "vanity-generator",
    "address-generator",
    "wallet-generator",
    "offline",
    "wasm",
    "cli",
    "npx",
    "cryptocurrency",
    "solana",
    "ethereum",
    "evm",
    "bitcoin",
    "zcash",
    "bitcoin-cash",
    "stacks",
    "decred",
    "nervos",
    "ckb",
    "tron",
    "ton",
    "sui",
    "cardano",
    "xrp",
    "dogecoin",
    "litecoin",
    "near",
    "kaspa",
    "stellar",
    "create2"
  ],
  "bin": {
    "vanity-address": "bin/cli.js"
  },
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./src/index.d.mts",
          "default": "./src/index.node.mjs"
        },
        "require": {
          "types": "./src/index.d.ts",
          "default": "./src/index.js"
        }
      },
      "import": {
        "types": "./src/index.d.mts",
        "default": "./src/index.mjs"
      },
      "require": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/cli.js",
    "src",
    "wasm",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "vanity-address-darwin-arm64": "0.8.0",
    "vanity-address-darwin-x64": "0.8.0",
    "vanity-address-linux-x64": "0.8.0",
    "vanity-address-win32-x64": "0.8.0"
  },
  "preferGlobal": true
}
